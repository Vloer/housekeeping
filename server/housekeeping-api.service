[Unit]
Description=Housekeeping Shared Task List FastAPI Backend
After=network.target

[Service]
User=root
WorkingDirectory=/opt/housekeeping
ExecStart=/opt/housekeeping/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000 --workers 2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
